# ── Secrets ────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
# TIMB credential encryption key, generated per install
includes/timb_key.php

# ── Data: database dumps, backups, user uploads ───────────────────────
backups/
*.sql
# ...except the schema baseline (structure only, no data)
!maintenance/schema.sql
*.sql.gz
uploads/*
!uploads/.htaccess
*.zip

# ── Scratch output (scripts in scratch/ are kept, their reports are not) ─
scratch/*
!scratch/.htaccess
!scratch/*.php

# ── Editor / local tool settings ──────────────────────────────────────
.idea/
.vscode/
.claude/settings.local.json

# ── Logs and OS files ─────────────────────────────────────────────────
*.log
Thumbs.db
.DS_Store

# Release packages built by maintenance/build_release.php
dist/
# Self-updater working files (downloads, staging, lock, installed file list)
updater/state/
