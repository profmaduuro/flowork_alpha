# ── Flowork Environment Configuration ──────────────────────────────────
# Copy to .env and fill in real values. NEVER commit the real .env.
#
# Generate each secret with something unguessable, e.g.:
#   php -r "echo bin2hex(random_bytes(24));"
#
# Secrets below must be at least 16 characters or the feature they guard
# stays switched off (fail closed) rather than falling back to a default.

# local = show PHP errors in pages (development). production = never show them.
# Also decides the XAMPP root/no-password database fallback when DB_HOST is unset.
APP_ENV=production

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user   # its own MySQL user with rights on this database only, never root
DB_PASS=your_secure_password_here

# Security setup key — unlocks the maintenance/setup scripts in the web root
# via ?key=... (see includes/admin_gate.php). Leave unset to disable key
# access entirely; localhost and a logged-in admin still get through.
SETUP_KEY=

# Backup token — allows auto_backup.php?token=... to run a full database dump
# WITHOUT a login, for cron/monitoring use. Leave unset to disable token
# access and require a normal admin login instead.
BACKUP_TOKEN=

# Diagnostics key for syscheck.php, on top of the normal login.
# Leave unset to require an administrator session instead.
SYSCHECK_KEY=

# Administrators and master users must set up two-factor authentication
# before they can use the system (1 = required). Recommended in production.
REQUIRE_ADMIN_2FA=1

# Reverse proxies whose X-Forwarded-For header may be trusted for rate
# limiting (comma-separated IPs). Leave empty when clients connect directly.
# Behind the Docker nginx container, set this to that container's IP,
# otherwise every client shares one rate-limit bucket.
TRUSTED_PROXIES=

# ── Docker (docker-compose.yml) ────────────────────────────────────────
# Required by `docker compose up`; it refuses to start without them.
MYSQL_ROOT_PASSWORD=
FLOWORK_DB_PASSWORD=
# APP_ENV inside the app container (default production).
DOCKER_APP_ENV=production

# ── Scheduled backup (maintenance/scheduled_backup.php) ────────────────
# Passphrase (16+ characters) that encrypts the database dump and the
# secrets bundle. Keep a copy somewhere safe OFF this server: without it the
# backups cannot be restored. Leave empty and backups stay unencrypted and
# are never copied off the machine.
BACKUP_PASSPHRASE=
# Folder on another disk or machine (mapped drive, NAS share, synced cloud
# folder) that receives an encrypted copy of every backup.
BACKUP_COPY_DIR=
# Days of backups to keep (default 30).
BACKUP_KEEP_DAYS=30
