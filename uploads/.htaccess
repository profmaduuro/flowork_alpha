# uploads/ is intentionally web-readable: company logos saved here are
# rendered by the app (settings.php stores 'uploads/'.$filename and pages
# load it by URL). So do NOT deny the directory outright. Instead:
#   1. never expose a browsable index of what has been uploaded, and
#   2. never let anything in here be executed server-side, since the
#      contents come from user uploads.

Options -Indexes

# Belt: turn the PHP engine off for this directory entirely.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Braces: refuse to serve executable/script types even if a handler exists.
<FilesMatch "(?i)\.(php|php[0-9]|phtml|phps|phar|inc|pl|py|cgi|sh|asp|aspx|jsp|shtml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Belt for SVG logos: even if a crafted SVG got past the upload check, opening
# it directly from here must not run script or load anything else.
<FilesMatch "(?i)\.svg$">
    <IfModule mod_headers.c>
        Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; sandbox"
        Header set X-Content-Type-Options "nosniff"
    </IfModule>
</FilesMatch>
