# Flowork web-root exposure rules.
#
# Deliberately narrow: this only refuses to serve file types the application
# never fetches over HTTP. Application .php pages, .js/.css assets, images
# and manifests are untouched.

# 1. Never serve dotfiles (.env, .env.example, .gitignore, ...).
#    .env.example matters: it publishes SETUP_KEY / BACKUP_TOKEN, and those
#    are the values admin_gate.php actually falls back to when no .env exists.
<FilesMatch "(?i)^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# 2. Never serve archives, database dumps, infrastructure config or
#    editor/backup leftovers.
# 3. Never serve key or certificate material. Public CA certs (e.g.
#    includes/certs/timb-ca.pem) are harmless to disclose, but this keeps any
#    private key that ever lands in the tree from being downloadable.
<FilesMatch "(?i)\.(zip|tar|gz|tgz|bz2|rar|7z|sql|bak|old|orig|swp|log|yml|yaml|cnf|dist|iml|pem|crt|cer|key|pfx|p12|jks)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Security headers on every response. The app never frames itself on
#    another site, so pages refuse to be framed (clickjacking), browsers may
#    not guess content types, and the PHP version is not advertised.
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set Permissions-Policy "geolocation=(self), camera=(self), microphone=()"
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

# 5. HTTPS. Active only once Apache has loaded conf/extra/httpd-ssl.conf with
#    "Define FLOWORK_HTTPS" (and the LAN certificate in conf/flowork-ssl).
#    308 keeps POSTs as POSTs. Not redirected: requests from this machine
#    (tests, scheduled tasks) and the mobile API under api/, until the
#    devices trust the Flowork Local CA.
<IfDefine FLOWORK_HTTPS>
    <IfModule mod_rewrite.c>
        RewriteEngine On
        RewriteCond %{HTTPS} off
        RewriteCond %{REMOTE_ADDR} !^(127\.0\.0\.1|::1)$
        RewriteCond %{REQUEST_URI} !/api/
        RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=308,L]
    </IfModule>
</IfDefine>
